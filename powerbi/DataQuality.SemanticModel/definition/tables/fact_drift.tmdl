/// Mesures des détecteurs d'anomalies et de dérive par lot.
table fact_drift
	lineageTag: e8875f3c-8baa-436b-a33d-7ef6acf3bba5

	column run_id
		dataType: string
		lineageTag: cc7e47ec-911f-414a-be4f-440055dda510
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

	column batch_id
		dataType: int64
		lineageTag: 027f1628-295b-4baa-8138-258c55c96fdb
		summarizeBy: none
		sourceColumn: batch_id

		annotation SummarizationSetBy = Automatic

	column batch_month
		dataType: string
		lineageTag: acc0abb8-5925-4c89-a2b9-1ac6876bba6e
		summarizeBy: none
		sourceColumn: batch_month

		annotation SummarizationSetBy = Automatic

	column detector
		dataType: string
		lineageTag: 677eabb9-1916-47e0-93dc-09414c9d75f1
		summarizeBy: none
		sourceColumn: detector

		annotation SummarizationSetBy = Automatic

	column column
		dataType: string
		lineageTag: f78bd93e-d04b-4051-9257-17851bad1d3b
		summarizeBy: none
		sourceColumn: column

		annotation SummarizationSetBy = Automatic

	column method
		dataType: string
		lineageTag: a471e1ac-458f-4ca0-ae5a-af1655cefec4
		summarizeBy: none
		sourceColumn: method

		annotation SummarizationSetBy = Automatic

	column value
		dataType: double
		formatString: 0.00
		lineageTag: 337d1d8a-5789-4a0d-a5ce-ad6f4fc79ff7
		summarizeBy: sum
		sourceColumn: value

		annotation SummarizationSetBy = Automatic

	column reference
		dataType: double
		formatString: 0.00
		lineageTag: cdc6c558-30d7-4483-8665-98c97b2c8718
		summarizeBy: sum
		sourceColumn: reference

		annotation SummarizationSetBy = Automatic

	column threshold
		dataType: double
		formatString: 0.00
		lineageTag: 3bfde185-fbaa-4eea-8a2e-6792db55fd44
		summarizeBy: sum
		sourceColumn: threshold

		annotation SummarizationSetBy = Automatic

	column is_anomaly
		dataType: boolean
		lineageTag: 5b5d8b88-7efc-4f11-86fb-6990625f91e0
		summarizeBy: none
		sourceColumn: is_anomaly

		annotation SummarizationSetBy = Automatic

	column BatchKey
		dataType: string
		isHidden
		lineageTag: b5205a0d-04db-449b-b068-622772631f03
		summarizeBy: none
		sourceColumn: BatchKey

		annotation SummarizationSetBy = Automatic

	partition fact_drift = m
		mode: import
		source =
				let
				    Source = fnLireCsv("fact_drift.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"batch_id", Int64.Type}, {"batch_month", type text}, {"detector", type text}, {"column", type text}, {"method", type text}, {"value", type number}, {"reference", type number}, {"threshold", type number}, {"is_anomaly", type logical}}, "en-US"),
				    AjoutCle = Table.AddColumn(Types, "BatchKey", each [run_id] & "|" & [batch_month], type text)
				in
				    AjoutCle

	annotation PBI_ResultType = Table

