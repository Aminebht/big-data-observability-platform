/// Évaluation : vrais et faux positifs par règle / détecteur.
table fact_detector_eval
	lineageTag: d23782c2-2601-4298-9e85-d67585be0b1e

	column detector_or_rule
		dataType: string
		lineageTag: 88dc64a2-f667-4313-a138-5cf9523dca3c
		summarizeBy: none
		sourceColumn: detector_or_rule

		annotation SummarizationSetBy = Automatic

	column tp
