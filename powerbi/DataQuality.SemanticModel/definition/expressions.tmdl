/// Lit un CSV UTF-8 depuis GitHub (URL) ou un dossier local, promeut les en-têtes et remplace les cellules vides par null.
expression fnLireCsv =
		(fichier as text) as table =>
		let
		    EstWeb = Text.StartsWith(SourceMetriques, "http"),
		    Sep = if EstWeb then "/" else "\",
		    Base = if Text.EndsWith(SourceMetriques, Sep) then SourceMetriques else SourceMetriques & Sep,
		    Contenu = if EstWeb then Web.Contents(Base, [RelativePath = fichier]) else File.Contents(Base & fichier),
		    Csv = Csv.Document(Contenu, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    EnTetes = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
		    VidesEnNull = Table.TransformColumns(EnTetes, List.Transform(Table.ColumnNames(EnTetes), each {_, (v) => if v = "" then null else v}))
		in
		    VidesEnNull
	lineageTag: 433cd11d-2c05-4e23-9649-4f2863c289f0

	annotation PBI_ResultType = Function

/// Emplacement des tables de résultats : URL GitHub (par défaut, fonctionne partout) ou dossier local.
expression SourceMetriques = "https://raw.githubusercontent.com/Aminebht/big-data-observability-platform/main/data/metrics/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 544a5006-3813-4f89-bd7c-99a99d938c0d

	annotation PBI_ResultType = Text

