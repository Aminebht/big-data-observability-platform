		summarizeBy: none
		sourceColumn: BatchKey

		annotation SummarizationSetBy = Automatic

	partition fact_alert = m
		mode: import
		source =
				let
				    Source = fnLireCsv("fact_alert.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"alert_id", type text}, {"batch_id", Int64.Type}, {"batch_month", type text}, {"source", type text}, {"detector_or_rule", type text}, {"column", type text}, {"severity", type text}, {"value", type number}, {"threshold", type number}, {"message", type text}, {"occurrences", Int64.Type}, {"first_batch", type text}, {"planted_fault", type text}, {"created_at", type text}}, "en-US"),
				    AjoutCle = Table.AddColumn(Types, "BatchKey", each [run_id] & "|" & [batch_month], type text)
				in
				    AjoutCle

	annotation PBI_ResultType = Table

