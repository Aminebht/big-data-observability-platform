	column message
		dataType: string
		lineageTag: 3df09acd-7218-44fb-90ee-4ad5b613e2ee
		summarizeBy: none
		sourceColumn: message

		annotation SummarizationSetBy = Automatic

	column occurrences
		dataType: int64
		lineageTag: e547c6f4-9b3c-483e-918e-c82ab8667785
		summarizeBy: sum
		sourceColumn: occurrences

		annotation SummarizationSetBy = Automatic

	column first_batch
		dataType: string
		lineageTag: e27ac0ad-dab4-4b81-8e80-6c7189e33485
		summarizeBy: none
