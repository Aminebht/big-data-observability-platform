	column severity
		dataType: string
		lineageTag: 800ae28d-2309-4c99-a3b8-13865453834f
		summarizeBy: none
		sourceColumn: severity

		annotation SummarizationSetBy = Automatic

	column value
		dataType: double
		formatString: 0.00
		lineageTag: e9ca62cb-54a4-476f-9261-5f5dda01a88a
		summarizeBy: sum
		sourceColumn: value

		annotation SummarizationSetBy = Automatic

	column threshold
		dataType: double
		formatString: 0.00
		lineageTag: 0d7530b3-63f2-47fa-b5cf-bf10d9bceb08
		summarizeBy: sum
		sourceColumn: threshold

