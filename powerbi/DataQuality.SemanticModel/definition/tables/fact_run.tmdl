	partition fact_run = m
		mode: import
		source =
				let
				    Source = fnLireCsv("fact_run.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"experiment", type text}, {"engine", type text}, {"cores", type text}, {"input_format", type text}, {"mode", type text}, {"fraction", type number}, {"rows", Int64.Type}, {"repeat", Int64.Type}, {"total_s", type number}, {"load_s", type number}, {"rules_s", type number}, {"detectors_s", type number}, {"write_s", type number}, {"rows_per_s", type number}, {"peak_mem_mb", type number}, {"alerts", Int64.Type}, {"status", type text}, {"started_at", type text}}, "en-US"),
				    AjoutCoeurs = Table.AddColumn(Types, "Coeurs", each if [cores] = "*" then "tous (12)" else [cores], type text),
				    AjoutLignes = Table.AddColumn(AjoutCoeurs, "Millions de lignes", each [rows] / 1000000, type number)
				in
				    AjoutLignes

	annotation PBI_ResultType = Table

