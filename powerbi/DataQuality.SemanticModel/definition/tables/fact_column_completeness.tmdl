/// Complétude de chaque attribut sur chaque lot.
table fact_column_completeness
	lineageTag: 1348dd44-264e-484a-af02-e638a52df954

	column run_id
		dataType: string
		lineageTag: 5c0878b6-4070-46ca-9d0f-3a8abde86d04
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

	column batch_id
		dataType: int64
		lineageTag: d725d94e-e1a0-4969-82f7-f60d3a231aa9
		summarizeBy: none
		sourceColumn: batch_id

		annotation SummarizationSetBy = Automatic

	column batch_month
		dataType: string
		lineageTag: 9f2a02f3-5a46-43d8-97a7-fe7a6a8d8300
		summarizeBy: none
		sourceColumn: batch_month

		annotation SummarizationSetBy = Automatic

	column column
		dataType: string
		lineageTag: b96bf61b-f0c3-4f8c-a0c4-deaefebb31bb
		summarizeBy: none
		sourceColumn: column

		annotation SummarizationSetBy = Automatic

	column rows
		dataType: int64
		lineageTag: ca2ae705-1a1f-40e8-acda-9add16e467c1
		summarizeBy: sum
		sourceColumn: rows

		annotation SummarizationSetBy = Automatic

	column missing
		dataType: int64
		lineageTag: 9f7efabb-130c-46d7-9cb5-0d855f9d6ad1
		summarizeBy: sum
		sourceColumn: missing

		annotation SummarizationSetBy = Automatic

	column missing_rate
		dataType: double
		formatString: 0.00
		lineageTag: a98567a8-29ea-476c-92ee-18690d053054
		summarizeBy: sum
		sourceColumn: missing_rate

		annotation SummarizationSetBy = Automatic

	column completeness_rate
		dataType: double
		formatString: 0.00
		lineageTag: db1065da-c33e-4c6a-97f8-7938b0b12940
		summarizeBy: sum
		sourceColumn: completeness_rate

		annotation SummarizationSetBy = Automatic

	column BatchKey
		dataType: string
		isHidden
		lineageTag: b688eb72-410c-4675-979d-dd3a89764873
		summarizeBy: none
		sourceColumn: BatchKey

		annotation SummarizationSetBy = Automatic

	partition fact_column_completeness = m
		mode: import
		source =
				let
				    Source = fnLireCsv("fact_column_completeness.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"batch_id", Int64.Type}, {"batch_month", type text}, {"column", type text}, {"rows", Int64.Type}, {"missing", Int64.Type}, {"missing_rate", type number}, {"completeness_rate", type number}}, "en-US"),
				    AjoutCle = Table.AddColumn(Types, "BatchKey", each [run_id] & "|" & [batch_month], type text)
				in
				    AjoutCle

	annotation PBI_ResultType = Table

