/// Exécutions de surveillance (clean = données d'origine, faulty = 12 lots abîmés volontairement).
table dim_run
	lineageTag: ea20bbe4-ea6a-474b-b7f0-ed230b4128db

	column run_id
		dataType: string
		lineageTag: 3b960ca8-d0ea-49a9-8ae7-4882a2b9e3bd
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

	partition dim_run = m
		mode: import
		source =
				let
				    Source = Table.Distinct(Table.SelectColumns(dim_batch, {"run_id"}))
				in
				    Source

	annotation PBI_ResultType = Table

