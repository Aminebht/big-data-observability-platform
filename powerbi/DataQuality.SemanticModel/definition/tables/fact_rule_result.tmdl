	partition fact_rule_result = m
		mode: import
		source =
				let
				    Source = fnLireCsv("fact_rule_result.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"batch_id", Int64.Type}, {"batch_month", type text}, {"rule_id", type text}, {"dimension", type text}, {"severity", type text}, {"mode", type text}, {"rows_checked", Int64.Type}, {"rows_failed", Int64.Type}, {"failure_rate", type number}, {"conformity_rate", type number}, {"status", type text}}, "en-US"),
				    AjoutCle = Table.AddColumn(Types, "BatchKey", each [run_id] & "|" & [batch_month], type text)
				in
				    AjoutCle

	annotation PBI_ResultType = Table

