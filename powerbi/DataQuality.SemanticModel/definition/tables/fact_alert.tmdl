/// Alertes générées (une ligne par lot ; une alerte récurrente garde le même alert_id).
table fact_alert
	lineageTag: 1f3b99e6-b445-4c82-bc2b-ec12d6e23e1e

	column run_id
		dataType: string
		lineageTag: 2d0d0b6b-3e28-4166-9cbb-87267af51e54
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

	column alert_id
		dataType: string
		lineageTag: 38439620-f532-41d3-913c-52f862b5ceee
		summarizeBy: none
		sourceColumn: alert_id

		annotation SummarizationSetBy = Automatic

	column batch_id
