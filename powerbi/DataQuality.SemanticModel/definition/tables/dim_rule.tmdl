		annotation SummarizationSetBy = Automatic

	partition dim_rule = m
		mode: import
		source =
				let
				    Source = fnLireCsv("dim_rule.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"rule_id", type text}, {"dimension", type text}, {"type", type text}, {"columns", type text}, {"severity", type text}, {"critical", type logical}, {"mode", type text}, {"max_fail_rate", type number}, {"description", type text}}, "en-US"),
				    AjoutDimension = Table.AddColumn(Types, "Dimension qualité", each Record.FieldOrDefault([completeness = "Complétude", uniqueness = "Unicité", validity = "Validité", consistency = "Cohérence", conformity = "Conformité"], [dimension], [dimension]), type text)
				in
				    AjoutDimension

	annotation PBI_ResultType = Table

