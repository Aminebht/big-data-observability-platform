	partition dim_batch = m
		mode: import
		source =
				let
				    Source = fnLireCsv("dim_batch.csv"),
				    Types = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"batch_id", Int64.Type}, {"batch_month", type text}, {"rows", Int64.Type}, {"processed_at", type text}, {"duration_s", type number}, {"global_score", type number}, {"status", type text}, {"forced_reasons", type text}, {"score_completeness", type number}, {"score_uniqueness", type number}, {"score_validity", type number}, {"score_consistency", type number}, {"score_conformity", type number}, {"schema_changed", type logical}, {"missing_columns", type text}, {"extra_columns", type text}, {"planted_faults", type text}}, "en-US"),
				    AjoutDate = Table.AddColumn(Types, "Date", each Date.FromText([batch_month] & "-01"), type date),
				    AjoutAnnee = Table.AddColumn(AjoutDate, "Annee", each Text.Start([batch_month], 4), type text),
				    AjoutStatut = Table.AddColumn(AjoutAnnee, "Statut", each if [status] = "healthy" then "Sain" else if [status] = "warning" then "Avertissement" else "Critique", type text),
				    AjoutDefaut = Table.AddColumn(AjoutStatut, "Defaut injecte", each if [planted_faults] = null then "—" else [planted_faults], type text),
				    AjoutCle = Table.AddColumn(AjoutDefaut, "BatchKey", each [run_id] & "|" & [batch_month], type text)
				in
				    AjoutCle

	annotation PBI_ResultType = Table

